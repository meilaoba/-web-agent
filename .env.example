# =====================================================
# AI驱动的Web代码安全审计多Agent系统 - 环境变量示例
# 复制本文件为 .env 后按需修改，切勿将 .env 提交到版本库
# =====================================================

# ---------- 路径配置 ----------
# RAG 原始知识数据目录（相对项目根目录）
# DATA_RAW_DIR=backend/data/raw
# RAG 处理产物输出目录
# DATA_PROCESSED_DIR=backend/data/processed

# ---------- RAG 文本分割参数（Phase 1）----------
# Chunk 目标大小（近似 token 数，500~1000）
# CHUNK_SIZE=800
# Chunk 重叠（近似 token 数，50~150）
# CHUNK_OVERLAP=100

# ---------- Embedding ----------
# 提供方: hashing（降级/测试，默认） | bge_m3（BGE-M3 本地模型）
EMBEDDING_PROVIDER=hashing
# BGE-M3 模型名或本地路径
# EMBEDDING_MODEL=BAAI/bge-m3
# 设备: cpu / cuda:0
# EMBEDDING_DEVICE=cpu
# Hashing 实现使用的向量维度
# EMBEDDING_DIMENSION=256

# ---------- ChromaDB ----------
# 向量库数据目录
# CHROMA_DIR=C:\chroma_data
# 注意：CHROMA_DIR 必须为纯 ASCII 路径（不含中文）！
# chroma-hnswlib(C++) 在中文路径下无法持久化 HNSW 索引，
# 会导致重启后检索报 'Cannot open header file'。
# 默认自动选择 ASCII 安全路径（优先本配置，其次数据目录，最后系统临时目录）
# Collection 名称
# CHROMA_COLLECTION=security_knowledge

# ---------- 检索 ----------
# 默认 Top-K
# RETRIEVAL_TOP_K=5
# 是否启用重排（true/false）
# RERANK_ENABLED=true

# ---------- LLM（统一 OpenAI 兼容 Provider 接口）----------
# 未配置 API Key 时自动使用 MockLLM（仅开发/演示）
# 支持的 Provider：qwen(千问) / deepseek / openai / ollama(本地) / openai_compatible / mock
# LLM_PROVIDER=qwen
# LLM_API_KEY=sk-xxx
# Base URL：留空时按 Provider 自动使用默认值（qwen 走 DashScope 兼容模式、
#          ollama 为 http://localhost:11434/v1、deepseek 为官方 API）
# LLM_BASE_URL=
# 模型名：qwen-max / deepseek-chat / gpt-4o-mini / qwen2.5:7b(ollama)
# LLM_MODEL=qwen-max
# LLM_TEMPERATURE=0.2

# 示例：本地 Ollama（无需 API Key 字段）
# LLM_PROVIDER=ollama
 #LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3:8b

# 示例：阿里云百炼千问（请将 sk-xxx 替换为你自己的密钥，切勿提交真实密钥到版本库）
# LLM_PROVIDER=qwen
# LLM_API_KEY=sk-你的密钥
# LLM_MODEL=qwen-max

# ---------- 数据库（MySQL / SQLite）----------
# sqlite（默认，本地） | mysql（部署）
DB_TYPE=sqlite
# 使用 MySQL 时配置：
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=ai_security_audit

# ---------- 认证安全 ----------
# JWT 签名密钥（生产环境务必设置随机值）
# JWT_SECRET=please-change-me
# 生产环境生成强随机密钥：python -c "import secrets; print(secrets.token_hex(32))"
# TOKEN_EXPIRE_HOURS=168

# ---------- 服务 ----------
# API_HOST=127.0.0.1
# API_PORT=8000

# ---------- CORS ----------
# 允许跨域访问的来源（逗号分隔）；留空=允许所有来源（仅限开发环境）
# 生产部署建议设置为前端域名，例如：CORS_ORIGINS=https://audit.example.com
# CORS_ORIGINS=

# ---------- 日志 ----------
# DEBUG / INFO / WARNING / ERROR
# LOG_LEVEL=INFO
